{
  "name": "snapdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first website capture and presentation studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder",
    "capture": "tsx scripts/capture.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "p-queue": "^8.1.0",
    "playwright": "^1.55.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.snapdeck.app",
    "productName": "SnapDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Noah0615",
      "repo": "webcapture",
      "releaseType": "release"
    },
    "icon": "build/icon.png"
  },
  "author": "Noah0615"
}
